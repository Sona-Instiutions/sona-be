{
  "kind": "collectionType",
  "collectionName": "event_comments",
  "info": {
    "singularName": "event-comment",
    "pluralName": "event-comments",
    "displayName": "Event Comment",
    "description": "Event Comment content type"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "event": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::event.event",
      "inversedBy": "comments"
    },
    "authorName": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "authorEmail": {
      "type": "email",
      "required": true
    },
    "content": {
      "type": "text",
      "required": true,
      "maxLength": 2000
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "spam"
      ],
      "default": "pending",
      "required": true
    },
    "ipAddress": {
      "type": "string",
      "maxLength": 45,
      "private": true
    },
    "userAgent": {
      "type": "text",
      "maxLength": 500,
      "private": true
    },
    "parentComment": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::event-comment.event-comment",
      "inversedBy": "replies"
    },
    "replies": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::event-comment.event-comment",
      "mappedBy": "parentComment"
    }
  }
}
