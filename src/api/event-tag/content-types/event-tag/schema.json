{
  "kind": "collectionType",
  "collectionName": "event_tags",
  "info": {
    "singularName": "event-tag",
    "pluralName": "event-tags",
    "displayName": "Event Tag",
    "description": "Event Tag content type"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 50
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "maxLength": 60
    },
    "events": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::event.event",
      "inversedBy": "tags"
    }
  }
}
